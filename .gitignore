# ---------- Dependencies ----------
node_modules/
**/node_modules/

# ---------- Build output ----------
dist/
build/
frontend/dist/

# ---------- Environment files (never commit secrets) ----------
.env
.env.*
!.env.example
!.env.*.example

# ---------- Test and coverage output ----------
coverage/
.nyc_output/

# ---------- Python cache (if any tooling is added later) ----------
__pycache__/
*.py[cod]

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editor and OS files ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ---------- Temporary files ----------
*.tmp
*.temp

# ---------- Private verification uploads (keep the folder itself) ----------
backend/uploads/verification/*
!backend/uploads/verification/.gitkeep
